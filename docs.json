{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Exmergo",
  "description": "Documentation for Exmergo, the AI stack for your data stack, and for its products, starting with Dex, the agent-native analytics engineering toolkit.",
  "colors": {
    "primary": "#2563eb",
    "light": "#60a5fa",
    "dark": "#2563eb"
  },
  "fonts": {
    "family": "Geist"
  },
  "appearance": {
    "default": "system"
  },
  "navigation": {
    "products": [
      {
        "product": "Exmergo",
        "description": "The AI stack for your data stack",
        "pages": ["index"]
      },
      {
        "$ref": "./dex/navigation.json"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://www.exmergo.com/discord?ref=docs"
      },
      {
        "label": "Dex Enterprise",
        "href": "https://www.exmergo.com/dex/enterprise"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/exmergo"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/exmergo",
      "x": "https://x.com/exmergo",
      "linkedin": "https://www.linkedin.com/company/exmergo/",
      "discord": "https://www.exmergo.com/discord?ref=docs",
      "website": "https://www.exmergo.com"
    }
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "og:site_name": "Exmergo",
      "twitter:site": "@exmergo"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt", "perplexity", "mcp", "add-mcp", "cursor", "vscode"]
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-D0VN4G61JD"
    }
  },
  "search": {
    "prompt": "Search the Exmergo docs"
  },
  "redirects": {
    "$ref": "./dex/redirects.json"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "Search the docs, or start from the [home page](/)."
    }
  }
}
