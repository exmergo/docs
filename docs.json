{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Exmergo",
  "description": "Documentation for Exmergo, the AI stack for your data stack, and for its products, starting with Dex, the agent-native analytics engineering toolkit.",
  "colors": {
    "primary": "#2563eb",
    "light": "#60a5fa",
    "dark": "#2563eb"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://docs.exmergo.com"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "IBM Plex Sans",
      "weight": 600
    },
    "body": {
      "family": "IBM Plex Sans"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#f5f4ef",
      "dark": "#0b1220"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark-dimmed"
      }
    }
  },
  "appearance": {
    "default": "system"
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/images/og-background.png",
    "fonts": {
      "family": "IBM Plex Sans"
    }
  },
  "navigation": {
    "products": [
      {
        "product": "Exmergo",
        "description": "The AI stack for your data stack",
        "pages": [
          "index"
        ],
        "icon": "building-2"
      },
      {
        "product": "Dex",
        "description": "Agent-native analytics engineering",
        "href": "https://docs.trydex.ai",
        "icon": "compass"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Discord",
        "href": "https://www.exmergo.com/discord?ref=docs"
      },
      {
        "label": "Dex Enterprise",
        "href": "https://www.exmergo.com/dex/enterprise"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/exmergo"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/exmergo",
      "x": "https://x.com/exmergo",
      "linkedin": "https://www.linkedin.com/company/exmergo/",
      "discord": "https://www.exmergo.com/discord?ref=docs",
      "website": "https://www.exmergo.com"
    }
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "canonical": "https://docs.exmergo.com",
      "og:site_name": "Exmergo",
      "twitter:site": "@exmergo"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt",
      "perplexity",
      "mcp",
      "add-mcp",
      "cursor",
      "vscode"
    ]
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-D0VN4G61JD"
    }
  },
  "search": {
    "prompt": "Search the Exmergo docs"
  },
  "redirects": [
    {
      "source": "/dex",
      "destination": "https://docs.trydex.ai"
    },
    {
      "source": "/dex/:slug*",
      "destination": "https://docs.trydex.ai/:slug*"
    }
  ],
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "Search the docs, or start from the [home page](/)."
    }
  }
}
